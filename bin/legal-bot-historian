#!/bin/bash
#
# vern-historian: Index a directory of input files into a structured concept map
#
# Delegates to the Go legal-bot CLI binary. Auto-downloads if not present.
#
# Usage: vern-historian <directory> [flags]
#
# Flags:
#   --llm <name>       Override LLM (default: gemini)
#   --timeout <secs>   Timeout in seconds (default: 600)
#

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERN_CLI="$SCRIPT_DIR/../go/bin/legal-bot"

# Auto-download if Go binary doesn't exist
if [ ! -x "$VERN_CLI" ]; then
    if command -v go &>/dev/null && [ -f "$SCRIPT_DIR/../go/cmd/legal-bot/main.go" ]; then
        echo "[vern-historian] Building legal-bot CLI from source..." >&2
        (cd "$SCRIPT_DIR/../go" && go build -o bin/legal-bot ./cmd/legal-bot) 2>/dev/null
    fi
    if [ ! -x "$VERN_CLI" ] && [ -x "$SCRIPT_DIR/install-legal-bot-cli" ]; then
        "$SCRIPT_DIR/install-legal-bot-cli"
    fi
    if [ ! -x "$VERN_CLI" ]; then
        echo "[vern-historian] Error: legal-bot CLI not available. Run: cd go && go build -o bin/legal-bot ./cmd/legal-bot" >&2
        exit 1
    fi
fi

exec "$VERN_CLI" historian "$@"
